# Copy this file to .env and fill in your values. .env is git-ignored — never commit real secrets.

# Required. Get this from the Govee Home app: Profile -> Settings -> Apply for API Key.
# See https://developer.govee.com/reference/apply-you-govee-api-key
GOVEE_API_KEY=

# Optional. Overrides where the SQLite shortcuts database lives inside the container.
# The default (set in the Dockerfile) already points at the mounted /data volume — only
# change this if you need a non-default path or filename.
# ConnectionStrings__ShortcutsDb=Data Source=/data/shortcuts.db

# Optional. Container timezone as an IANA name (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones),
# e.g. America/Chicago or Europe/London. Anything time-of-day-based inside the container —
# including scheduled shortcuts — is interpreted in this timezone. Defaults to UTC when unset.
# TZ=America/Chicago
