@* Self-contained control panel for a single Govee device: power toggle, brightness slider,
   color/color-temperature pickers, and a dropdown of the device's Govee scenes. Loads its own
   state and talks directly to IDeviceControlService, so the parent page only has to render one
   <DeviceCard> per device. *@
@implements IDisposable
@using GoveeController.Application.Devices
@using GoveeController.Domain.Devices
@inject IDeviceControlService DeviceControlService
@inject ILogger<DeviceCard> Logger

<div class="card">
    <h3>@Device.Name</h3>
    <div class="sku">@Device.Sku</div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    @if (_state is null)
    {
        @if (_error is null)
        {
            <p><em>Loading state…</em></p>
        }
    }
    else
    {
        @if (Device.SupportsPower)
        {
            <div class="control-row">
                <label>Power</label>
                <button class="toggle-btn @(_state.PowerOn ? "on" : "off")" @onclick="TogglePowerAsync" disabled="@_busy">
                    @(_state.PowerOn ? "On" : "Off")
                </button>
            </div>
        }

        @if (Device.SupportsBrightness)
        {
            var brightnessCap = Device.Capabilities.First(c => c.Kind == CapabilityKind.Brightness);
            <div class="control-row">
                <label>Brightness</label>
                <input type="number"
                       min="0"
                       max="100"
                       value="@(_state.Brightness ?? brightnessCap.Min ?? 1)"
                       disabled="@_busy"
                       @onchange="OnBrightnessChangedAsync" />
                <span>%</span>
            </div>
            <div class="control-hint">Enter a whole number from 0 to 100.</div>
        }

        @if (Device.SupportsColorRgb)
        {
            <div class="control-row">
                <label>Color</label>
                <input type="color" value="@((_state.Color ?? new RgbColor(255, 255, 255)).ToHex())" disabled="@_busy" @onchange="OnColorChangedAsync" />
            </div>
        }

        @if (Device.SupportsColorTemperature)
        {
            var tempCap = Device.Capabilities.First(c => c.Kind == CapabilityKind.ColorTemperature);
            // Govee reports 0K (not null) when the bulb is currently in RGB mode rather than
            // color-temperature mode - treat that as "unknown" rather than a real, selectable value.
            var currentKelvin = _state.ColorTemperatureKelvin is > 0 ? _state.ColorTemperatureKelvin.Value : tempCap.Min ?? 2000;
            <div class="control-row">
                <label>Warmth</label>
                <select value="@currentKelvin.ToString()" disabled="@_busy" @onchange="OnColorTemperatureChangedAsync">
                    @foreach (var kelvin in WarmthOptions(tempCap, currentKelvin))
                    {
                        <option value="@kelvin">@kelvin K</option>
                    }
                </select>
            </div>
        }

        @if (Device.SupportsScenes)
        {
            <div class="control-row">
                <label>Scene</label>
                @if (_scenes is null)
                {
                    <button class="btn" @onclick="LoadScenesAsync" disabled="@_busy">Load scenes…</button>
                }
                else if (_scenes.Count == 0)
                {
                    <span><em>No scenes configured</em></span>
                }
                else
                {
                    <select disabled="@_busy" @onchange="OnSceneSelectedAsync">
                        <option value="">Choose a scene…</option>
                        @foreach (var scene in _scenes)
                        {
                            <option value="@scene.Id">@scene.Name</option>
                        }
                    </select>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The device this card controls. Required.</summary>
    [Parameter, EditorRequired]
    public required Device Device { get; set; }

    /// <summary>
    /// Bumped by the parent page's "Refresh" button to force this card to re-fetch state,
    /// bypassing the cache. Any change in value (regardless of direction) triggers a refresh.
    /// </summary>
    [Parameter]
    public int RefreshSignal { get; set; }

    /// <summary>
    /// A "set this on every bulb" instruction broadcast from the Devices page's bulk controls. A
    /// new <see cref="BulkLightCommand.Id"/> triggers applying whichever fields are populated, for
    /// whichever of them this device actually supports.
    /// </summary>
    [Parameter]
    public BulkLightCommand? BulkCommand { get; set; }

    private int _lastRefreshSignal;
    private int _lastBulkCommandId;
    private LightState? _state;
    private IReadOnlyList<GoveeScene>? _scenes;
    private bool _busy;
    private string? _error;

    // Cancelled on Dispose so an in-flight Govee call for a card the user has navigated away from
    // doesn't run to completion and then touch a disposed component.
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _lastRefreshSignal = RefreshSignal;
        _lastBulkCommandId = BulkCommand?.Id ?? 0;
        await RefreshStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RefreshSignal != _lastRefreshSignal)
        {
            _lastRefreshSignal = RefreshSignal;
            await RefreshStateAsync(forceRefresh: true);
        }

        if (BulkCommand is { } bulkCommand && bulkCommand.Id != _lastBulkCommandId)
        {
            _lastBulkCommandId = bulkCommand.Id;
            await ApplyBulkCommandAsync(bulkCommand);
        }
    }

    /// <summary>
    /// Applies whichever fields of a bulk command this device supports, one at a time through the
    /// same optimistic-update path as its own controls (see the private Set*Async helpers below,
    /// shared with the individual per-control handlers), and simply skips fields it doesn't
    /// support (e.g. a bulk color change is a no-op on a white-only fixture).
    /// </summary>
    private async Task ApplyBulkCommandAsync(BulkLightCommand command)
    {
        if (command.Brightness is { } brightness && Device.SupportsBrightness)
        {
            await SetBrightnessAsync(brightness);
        }

        if (command.Color is { } color && Device.SupportsColorRgb)
        {
            await SetColorAsync(color);
        }

        if (command.ColorTemperatureKelvin is { } kelvin && Device.SupportsColorTemperature)
        {
            await SetColorTemperatureAsync(kelvin);
        }
    }

    private async Task RefreshStateAsync(bool forceRefresh = false)
    {
        try
        {
            _state = await DeviceControlService.GetStateAsync(Device.Sku, Device.Id, forceRefresh, _cts.Token);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Loading state");
        }
    }

    /// <summary>
    /// Runs a control command and, on success, applies <paramref name="applyOptimistically"/> to the
    /// locally-held state instead of re-fetching it from Govee. Govee's cloud state read doesn't
    /// always reflect a control command immediately — re-querying right after sending one can return
    /// the pre-command value, making the UI look like the click did nothing. Since a successful
    /// command call means Govee accepted and applied it, trusting the intended new value locally is
    /// both faster and more reliable; the "Refresh" button (or the next scheduled poll) reconciles
    /// with Govee's authoritative state if it ever drifts.
    /// </summary>
    private async Task RunCommandAsync(Func<Task> command, Func<LightState, LightState> applyOptimistically)
    {
        _busy = true;
        try
        {
            await command();
            if (_state is not null)
            {
                _state = applyOptimistically(_state);
            }
            _error = null;
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Command");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task TogglePowerAsync()
    {
        var turningOn = !_state!.PowerOn;
        return RunCommandAsync(
            () => turningOn
                ? DeviceControlService.TurnOnAsync(Device.Sku, Device.Id, _cts.Token)
                : DeviceControlService.TurnOffAsync(Device.Sku, Device.Id, _cts.Token),
            s => s with { PowerOn = turningOn });
    }

    private Task OnBrightnessChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var brightness) || brightness is < 0 or > 100)
        {
            _error = "Brightness must be a whole number from 0 to 100.";
            return Task.CompletedTask;
        }

        return SetBrightnessAsync(brightness);
    }

    private Task OnColorChangedAsync(ChangeEventArgs e) => SetColorAsync(RgbColor.FromHex((string)e.Value!));

    private Task OnColorTemperatureChangedAsync(ChangeEventArgs e) => SetColorTemperatureAsync(int.Parse((string)e.Value!));

    /// <summary>
    /// Govee reports color temperature as a continuous integer range (e.g. this account's H600A
    /// bulbs: 2700-6500K, precision 1 - confirmed by querying the live devices API directly, not
    /// assumed), not a fixed list of presets - offering all ~3800 individual Kelvin values in a
    /// dropdown would be unusable, so this buckets the device's actual min/max into 100K steps.
    /// The device's current value is always included even if it falls off that grid (e.g. a Govee
    /// scene set an odd value), so the dropdown never silently shows the wrong selection.
    /// </summary>
    private static IReadOnlyList<int> WarmthOptions(DeviceCapability tempCap, int currentKelvin)
    {
        const int step = 100;
        var min = tempCap.Min ?? 2000;
        var max = tempCap.Max ?? 9000;

        var values = new List<int>();
        for (var kelvin = min; kelvin < max; kelvin += step)
        {
            values.Add(kelvin);
        }
        values.Add(max);

        if (!values.Contains(currentKelvin))
        {
            values.Add(currentKelvin);
            values.Sort();
        }

        return values;
    }

    // Shared by both the per-control @onchange handlers above and ApplyBulkCommandAsync, so the
    // two paths can't drift apart on what "set brightness/color/color-temperature" actually means.
    private Task SetBrightnessAsync(int brightness) =>
        RunCommandAsync(
            () => DeviceControlService.SetBrightnessAsync(Device.Sku, Device.Id, brightness, _cts.Token),
            s => s with { Brightness = brightness });

    private Task SetColorAsync(RgbColor color) =>
        RunCommandAsync(
            () => DeviceControlService.SetColorAsync(Device.Sku, Device.Id, color, _cts.Token),
            s => s with { Color = color });

    private Task SetColorTemperatureAsync(int kelvin) =>
        RunCommandAsync(
            () => DeviceControlService.SetColorTemperatureAsync(Device.Sku, Device.Id, kelvin, _cts.Token),
            s => s with { ColorTemperatureKelvin = kelvin });

    private async Task LoadScenesAsync()
    {
        try
        {
            _scenes = await DeviceControlService.ListScenesAsync(Device.Sku, Device.Id, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Loading scenes");
        }
    }

    private Task OnSceneSelectedAsync(ChangeEventArgs e)
    {
        if (string.IsNullOrEmpty((string?)e.Value) || _scenes is null)
        {
            return Task.CompletedTask;
        }

        var sceneId = int.Parse((string)e.Value!);
        var scene = _scenes.First(s => s.Id == sceneId);
        // A scene's resulting brightness/color aren't known client-side, but activating one always
        // turns the device on — reflect at least that much immediately rather than nothing.
        return RunCommandAsync(
            () => DeviceControlService.TriggerSceneAsync(Device.Sku, Device.Id, scene, _cts.Token),
            s => s with { PowerOn = true });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
