@page "/shortcuts"
@implements IDisposable
@using GoveeController.Application.Devices
@using GoveeController.Application.Shortcuts
@using GoveeController.Domain.Devices
@using GoveeController.Domain.Shortcuts
@using GoveeController.Web.Components.Shared
@inject IShortcutService ShortcutService
@inject IDeviceControlService DeviceControlService
@inject ILogger<Shortcuts> Logger

<PageTitle>Shortcuts</PageTitle>

<h1>Shortcuts</h1>
<p>Saved presets that set a device's power, brightness, and color in one click.</p>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

@if (_shortcuts is null)
{
    <p><em>Loading shortcuts…</em></p>
}
else if (_shortcuts.Count == 0)
{
    <p class="empty-state">No shortcuts saved yet.</p>
}
else
{
    <div class="shortcut-list">
        @foreach (var shortcut in _shortcuts)
        {
            <div class="shortcut-row">
                <button type="button" class="shortcut-toggle"
                        aria-expanded="@(IsExpanded(shortcut.Id) ? "true" : "false")"
                        @onclick="() => ToggleExpanded(shortcut.Id)">
                    <span class="shortcut-caret" aria-hidden="true">@(IsExpanded(shortcut.Id) ? "▾" : "▸")</span>
                    <strong>@shortcut.Name</strong>
                </button>

                <div class="shortcut-actions">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="() => ApplyAsync(shortcut.Id)">
                        @(_applyingId == shortcut.Id ? "Applying…" : "Apply")
                    </button>
                    <button class="btn" disabled="@_busy" @onclick="() => StartEdit(shortcut)">Edit</button>
                    <button class="btn btn-danger" disabled="@_busy" @onclick="() => DeleteAsync(shortcut.Id)">Delete</button>
                </div>

                @if (IsExpanded(shortcut.Id))
                {
                    <div class="shortcut-details">
                        <ul>
                            @foreach (var name in DeviceNamesListFor(shortcut))
                            {
                                <li>@name</li>
                            }
                        </ul>
                        <div>@(shortcut.PowerOn ? "On" : "Off")@(shortcut.Brightness is { } b ? $" · {b}%" : "")</div>
                        @if (ChainLabelFor(shortcut) is { } chainLabel)
                        {
                            <div>@chainLabel</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<h2>@(_editingId is null ? "New shortcut" : "Edit shortcut")</h2>

@if (_devices is null)
{
    @if (_error is null)
    {
        <p><em>Loading devices…</em></p>
    }
}
else if (_devices.Count == 0)
{
    <p class="empty-state">No devices available to create a shortcut for.</p>
}
else
{
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <div class="form-grid">
            <div>
                <label>Name</label>
                <InputText @bind-Value="_form.Name" placeholder="e.g. Movie Mode" />
            </div>
            <div>
                <label>Devices</label>
                <button type="button" class="btn device-picker-trigger" @onclick="() => _showDeviceModal = true">
                    @DeviceDropdownSummary()
                </button>
            </div>
            <div>
                <label>Power</label>
                <InputSelect @bind-Value="_form.PowerOn">
                    <option value="true">On</option>
                    <option value="false">Off</option>
                </InputSelect>
            </div>
            <div>
                <label>Brightness (optional)</label>
                <InputNumber @bind-Value="_form.Brightness" min="0" max="100" />
                <div class="control-hint">Enter a whole number from 0 to 100.</div>
            </div>
            <div>
                <label>Color (optional)</label>
                <InputText type="color" @bind-Value="_form.ColorHex" />
            </div>
            <div>
                <label>Warmth (optional)</label>
                <select value="@(_form.ColorTemperatureKelvin?.ToString() ?? "")" @onchange="OnFormColorTemperatureChanged">
                    <option value="">Not set</option>
                    @foreach (var kelvin in WarmthOptions.Generate(ColorTemperatureMin, ColorTemperatureMax, _form.ColorTemperatureKelvin ?? ColorTemperatureMin))
                    {
                        <option value="@kelvin">@kelvin K</option>
                    }
                </select>
            </div>
            <div>
                <label>Then run (optional)</label>
                <select value="@(_form.NextShortcutId?.ToString() ?? "")" @onchange="OnFormNextShortcutChanged">
                    <option value="">None</option>
                    @foreach (var candidate in _eligibleNextShortcuts)
                    {
                        <option value="@candidate.Id">@candidate.Name</option>
                    }
                </select>
            </div>
            @if (_form.NextShortcutId is not null)
            {
                <div>
                    <label>Delay before next (seconds)</label>
                    <InputNumber @bind-Value="_form.NextShortcutDelaySeconds" min="0" max="60" />
                    <div class="control-hint">Enter a whole number from 0 to 60. A longer delay helps chains covering many bulbs avoid Govee's rate limit.</div>
                </div>
            }
        </div>
        <p class="meta" style="margin-top:0.4rem;">Set either a color or a color temperature, not both.</p>
        <button class="btn btn-primary" type="submit" disabled="@_busy" style="margin-top:0.5rem;">
            @(_editingId is null ? "Save shortcut" : "Update shortcut")
        </button>
        @if (_editingId is not null)
        {
            <button class="btn" type="button" disabled="@_busy" style="margin-top:0.5rem;" @onclick="CancelEdit">Cancel</button>
        }
    </EditForm>

    @if (_showDeviceModal)
    {
        <div class="modal-backdrop" @onclick="() => _showDeviceModal = false">
            <div class="modal-panel" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Select devices</h3>
                    <button type="button" class="btn" @onclick="() => _showDeviceModal = false">✕</button>
                </div>

                <div class="modal-body">
                    <h4>Bulbs</h4>
                    <div class="device-checklist">
                        @foreach (var device in _devices.Where(d => d.IsIndividualLight))
                        {
                            <label class="device-checklist-item">
                                <input type="checkbox"
                                       checked="@_form.SelectedDeviceIds.Contains(device.Id)"
                                       @onchange="e => ToggleDevice(device.Id, (bool)e.Value!)" />
                                @device.Name
                            </label>
                        }
                    </div>

                    @{
                        var otherDevices = _devices.Where(d => !d.IsIndividualLight).ToList();
                    }
                    @if (otherDevices.Count > 0)
                    {
                        <h4>Groups &amp; scenes</h4>
                        <div class="device-checklist">
                            @foreach (var device in otherDevices)
                            {
                                <label class="device-checklist-item">
                                    <input type="checkbox"
                                           checked="@_form.SelectedDeviceIds.Contains(device.Id)"
                                           @onchange="e => ToggleDevice(device.Id, (bool)e.Value!)" />
                                    @device.Name
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="() => _showDeviceModal = false">Done</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<Shortcut>? _shortcuts;
    private IReadOnlyList<Device>? _devices;
    private IReadOnlyList<Shortcut> _eligibleNextShortcuts = [];
    private readonly ShortcutFormModel _form = new();
    private bool _busy;
    private bool _showDeviceModal;
    private string? _error;
    private int? _editingId;

    // Which shortcut's Apply button should show a busy label, distinct from the page-wide _busy
    // flag - _busy also goes true for an Edit/Delete/Save on a different row, and a chain-linked
    // shortcut can now take up to ~2 minutes to apply (see ShortcutService.ApplyShortcutAsync), so
    // showing "Applying…" for every row whenever anything on the page is busy would be misleading.
    private int? _applyingId;

    // Which rows are expanded. A set (not a single int) because rows expand independently - opening
    // one must not collapse another. Transient view state: deliberately not persisted.
    private readonly HashSet<int> _expandedShortcutIds = [];

    // Cancelled on dispose so an in-flight Govee/EF call doesn't run to completion and then touch
    // a disposed component (e.g. the user navigating away mid-request).
    private readonly CancellationTokenSource _cts = new();

    /// <summary>
    /// Warmth dropdown bounds, as the intersection across every known device that supports color
    /// temperature — the most restrictive lower bound and upper bound of all of them, so any value
    /// offered stays valid regardless of which devices this shortcut ends up targeting.
    /// </summary>
    private int ColorTemperatureMin => CapabilityRange.Bound(_devices ?? [], CapabilityKind.ColorTemperature, c => c.Min ?? 2000, bounds => bounds.Max(), fallback: 2000);
    private int ColorTemperatureMax => CapabilityRange.Bound(_devices ?? [], CapabilityKind.ColorTemperature, c => c.Max ?? 9000, bounds => bounds.Min(), fallback: 9000);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shortcuts = await ShortcutService.ListShortcutsAsync(_cts.Token);
            _devices = await DeviceControlService.ListDevicesAsync(cancellationToken: _cts.Token);
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Loading");
        }

        await RefreshEligibleNextShortcutsAsync();
    }

    /// <summary>
    /// Re-fetches which shortcuts are legal choices for the "Then run" dropdown, scoped to
    /// whichever shortcut the form is currently editing (null while creating a new one). Must be
    /// re-run after every save/delete and whenever _editingId changes, since linking/unlinking
    /// changes what's eligible for everyone else.
    /// </summary>
    private async Task RefreshEligibleNextShortcutsAsync()
    {
        try
        {
            _eligibleNextShortcuts = await ShortcutService.ListEligibleNextShortcutsAsync(_editingId, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Loading eligible shortcuts");
        }
    }

    private async Task ApplyAsync(int id)
    {
        _busy = true;
        _applyingId = id;
        try
        {
            await ShortcutService.ApplyShortcutAsync(id, _cts.Token);
            _error = null;
        }
        catch (ShortcutApplyException ex)
        {
            // Applying is best-effort per target (see ShortcutService.ApplyShortcutAsync), so a
            // partial failure still means most/all lights did what was asked — say so precisely
            // rather than a blanket "failed" that reads as if nothing happened. Grouped by which
            // chain step (shortcut) each failure came from, since applying a linked shortcut can
            // run more than one shortcut and a bare device name no longer says which step it's from.
            var failuresByShortcut = ex.Failures
                .GroupBy(f => f.ShortcutName)
                .Select(g => $"{g.Key}: {string.Join(", ", g.Select(f => _devices?.FirstOrDefault(d => d.Id == f.DeviceId)?.Name ?? f.DeviceSku))}");
            _error = $"Applied to {ex.SucceededCount} of {ex.TotalCount} device(s). Failed: {string.Join("; ", failuresByShortcut)}.";
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Applying shortcut");
        }
        finally
        {
            _busy = false;
            _applyingId = null;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        try
        {
            await ShortcutService.DeleteShortcutAsync(id, _cts.Token);
            _shortcuts = await ShortcutService.ListShortcutsAsync(_cts.Token);
            if (_editingId == id)
            {
                ResetForm();
            }
            await RefreshEligibleNextShortcutsAsync();
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Deleting shortcut");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_devices is null)
        {
            return;
        }

        var targets = _devices
            .Where(d => _form.SelectedDeviceIds.Contains(d.Id))
            .Select(d => (d.Sku, d.Id))
            .ToList();
        if (targets.Count == 0)
        {
            _error = "Select at least one device.";
            return;
        }

        _busy = true;
        try
        {
            RgbColor? color = string.IsNullOrWhiteSpace(_form.ColorHex) ? null : RgbColor.FromHex(_form.ColorHex);
            if (color is not null && _form.ColorTemperatureKelvin is not null)
            {
                _error = "Set either a color or a color temperature, not both.";
                return;
            }

            if (_editingId is { } id)
            {
                await ShortcutService.UpdateShortcutAsync(
                    id,
                    _form.Name,
                    targets,
                    _form.PowerOn,
                    _form.Brightness,
                    color,
                    _form.ColorTemperatureKelvin,
                    _form.NextShortcutId,
                    _form.NextShortcutDelaySeconds,
                    _cts.Token);
            }
            else
            {
                await ShortcutService.CreateShortcutAsync(
                    _form.Name,
                    targets,
                    _form.PowerOn,
                    _form.Brightness,
                    color,
                    _form.ColorTemperatureKelvin,
                    _form.NextShortcutId,
                    _form.NextShortcutDelaySeconds,
                    _cts.Token);
            }

            _shortcuts = await ShortcutService.ListShortcutsAsync(_cts.Token);
            ResetForm();
            await RefreshEligibleNextShortcutsAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Saving shortcut");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartEdit(Shortcut shortcut)
    {
        _editingId = shortcut.Id;
        _form.Name = shortcut.Name;
        _form.SelectedDeviceIds.Clear();
        foreach (var target in shortcut.Targets)
        {
            _form.SelectedDeviceIds.Add(target.DeviceId);
        }
        _form.PowerOn = shortcut.PowerOn;
        _form.Brightness = shortcut.Brightness;
        _form.ColorHex = shortcut.ColorRgbPacked is { } packed ? RgbColor.FromPackedInt(packed).ToHex() : string.Empty;
        _form.ColorTemperatureKelvin = shortcut.ColorTemperatureKelvin;
        _form.NextShortcutId = shortcut.NextShortcutId;
        _form.NextShortcutDelaySeconds = shortcut.NextShortcutDelaySeconds;
        _error = null;
        // Eligibility depends on which shortcut is being edited (a shortcut may legally "keep" its
        // own current link even though nothing else may take it), so this must be re-scoped here.
        await RefreshEligibleNextShortcutsAsync();
    }

    private async Task CancelEdit()
    {
        ResetForm();
        _error = null;
        await RefreshEligibleNextShortcutsAsync();
    }

    private void ResetForm()
    {
        _editingId = null;
        _form.Name = string.Empty;
        _form.SelectedDeviceIds.Clear();
        _form.PowerOn = true;
        _form.Brightness = null;
        _form.ColorHex = string.Empty;
        _form.ColorTemperatureKelvin = null;
        _form.NextShortcutId = null;
        _form.NextShortcutDelaySeconds = 0;
    }

    private void OnFormColorTemperatureChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value;
        _form.ColorTemperatureKelvin = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    private void OnFormNextShortcutChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value;
        _form.NextShortcutId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
        if (_form.NextShortcutId is null)
        {
            // Matches ShortcutService's own normalization (a stale delay must not reappear if this
            // shortcut is relinked later) - kept here too so the form reflects it immediately.
            _form.NextShortcutDelaySeconds = 0;
        }
    }

    private void ToggleDevice(string deviceId, bool isSelected)
    {
        if (isSelected)
        {
            _form.SelectedDeviceIds.Add(deviceId);
        }
        else
        {
            _form.SelectedDeviceIds.Remove(deviceId);
        }
    }

    private string DeviceDropdownSummary()
    {
        var count = _form.SelectedDeviceIds.Count;
        return count switch
        {
            0 => "Select devices…",
            1 => "1 device selected",
            _ => $"{count} devices selected"
        };
    }

    private bool IsExpanded(int shortcutId) => _expandedShortcutIds.Contains(shortcutId);

    private void ToggleExpanded(int shortcutId)
    {
        if (!_expandedShortcutIds.Add(shortcutId))
        {
            _expandedShortcutIds.Remove(shortcutId);
        }
    }

    /// <summary>Target device names for the expanded panel's list, one entry per device.</summary>
    private IReadOnlyList<string> DeviceNamesListFor(Shortcut shortcut)
    {
        if (_devices is null)
        {
            return [$"{shortcut.Targets.Count} device(s)"];
        }

        return shortcut.Targets
            .Select(t => _devices.FirstOrDefault(d => d.Id == t.DeviceId)?.Name ?? t.DeviceSku)
            .ToList();
    }

    /// <summary>
    /// "→ then {name} (after Ns)" row metadata for a shortcut that has a chain link, or null for
    /// one that doesn't. Resolves the linked shortcut's name from the already-loaded list rather
    /// than a fresh call, same approach as <see cref="DeviceNamesListFor"/>.
    /// </summary>
    private string? ChainLabelFor(Shortcut shortcut)
    {
        if (shortcut.NextShortcutId is not { } nextId)
        {
            return null;
        }

        var nextName = _shortcuts?.FirstOrDefault(s => s.Id == nextId)?.Name ?? $"#{nextId}";
        var delaySuffix = shortcut.NextShortcutDelaySeconds > 0 ? $" (after {shortcut.NextShortcutDelaySeconds}s)" : "";
        return $"→ then {nextName}{delaySuffix}";
    }

    /// <summary>Backing model for the "new shortcut" form; kept simple/flat for Blazor's EditForm binding.</summary>
    private sealed class ShortcutFormModel
    {
        public string Name { get; set; } = string.Empty;
        public HashSet<string> SelectedDeviceIds { get; } = [];
        public bool PowerOn { get; set; } = true;
        public int? Brightness { get; set; }
        public string ColorHex { get; set; } = string.Empty;
        public int? ColorTemperatureKelvin { get; set; }
        public int? NextShortcutId { get; set; }
        public int NextShortcutDelaySeconds { get; set; }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
