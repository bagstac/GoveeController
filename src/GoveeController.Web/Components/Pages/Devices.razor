@page "/"
@implements IAsyncDisposable
@using GoveeController.Application.Devices
@using GoveeController.Domain.Devices
@using GoveeController.Web.Components.Shared
@inject IDeviceControlService DeviceControlService
@inject IJSRuntime JSRuntime
@inject ILogger<Devices> Logger

<PageTitle>Devices</PageTitle>

<div class="page-header">
    <h1>Devices</h1>
    <div class="page-header-actions">
        <div class="auto-refresh-group">
            <label class="auto-refresh-label">
                Auto-refresh:
                <select value="@_autoRefreshSeconds" @onchange="OnAutoRefreshChanged">
                    <option value="0">Off</option>
                    <option value="30">30 seconds</option>
                    <option value="60">1 minute</option>
                    <option value="300">5 minutes</option>
                    <option value="600">10 minutes</option>
                    <option value="1800">30 minutes</option>
                </select>
            </label>
            @if (_lastRefreshedLocalTime is not null)
            {
                <span class="last-refreshed">Last refreshed @_lastRefreshedLocalTime</span>
            }
        </div>
        <button class="btn" disabled="@_refreshing" @onclick="RefreshAsync">
            @(_refreshing ? "Refreshing…" : "↻ Refresh")
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}
else if (_devices is null)
{
    <p><em>Loading devices…</em></p>
}
else if (_devices.Count == 0)
{
    <p class="empty-state">No Govee light bulbs found on this account.</p>
}
else
{
    <div class="card bulk-controls">
        <h3>Set All Bulbs</h3>
        <div class="control-row">
            <label>Brightness</label>
            <input type="number"
                   min="0"
                   max="100"
                   value="@_bulkBrightness"
                   @onchange="OnBulkBrightnessChanged" />
            <span>%</span>
        </div>
        <div class="control-hint">Enter a whole number from 0 to 100.</div>
        <div class="control-row">
            <label>Color</label>
            <input type="color" value="@_bulkColorHex" @onchange="OnBulkColorChanged" />
        </div>
        <div class="control-row">
            <label>Warmth</label>
            <select value="@_bulkColorTemperatureKelvin.ToString()" @onchange="OnBulkColorTemperatureChanged">
                @foreach (var kelvin in WarmthOptions.Generate(BulkColorTemperatureMin, BulkColorTemperatureMax, _bulkColorTemperatureKelvin))
                {
                    <option value="@kelvin">@kelvin K</option>
                }
            </select>
        </div>
    </div>

    <div class="device-grid">
        @foreach (var device in _devices)
        {
            <DeviceCard Device="device" @key="device.Id" RefreshSignal="_refreshSignal" BulkCommand="_bulkCommand" />
        }
    </div>
}

@code {
    private IReadOnlyList<Device>? _devices;
    private string? _error;
    private bool _refreshing;
    private int _refreshSignal;
    private int _autoRefreshSeconds;
    private System.Threading.Timer? _autoRefreshTimer;
    private string? _lastRefreshedLocalTime;
    private int _bulkBrightness = 100;
    private string _bulkColorHex = "#ffffff";
    private int _bulkColorTemperatureKelvin = 4000;
    private int _bulkCommandId;
    private BulkLightCommand? _bulkCommand;

    // Cancelled on dispose so an in-flight Govee call doesn't run to completion and then touch a
    // disposed component (e.g. the user navigating away mid-refresh).
    private readonly CancellationTokenSource _cts = new();

    /// <summary>
    /// Bulk warmth dropdown bounds, as the intersection across every bulb that supports color
    /// temperature — the most restrictive lower bound and upper bound of all of them, so any value
    /// offered is guaranteed valid for every device it gets applied to.
    /// </summary>
    private int BulkColorTemperatureMin => RangeBound(CapabilityKind.ColorTemperature, c => c.Min ?? 2000, bounds => bounds.Max(), fallback: 2000);
    private int BulkColorTemperatureMax => RangeBound(CapabilityKind.ColorTemperature, c => c.Max ?? 9000, bounds => bounds.Min(), fallback: 9000);

    private int RangeBound(CapabilityKind kind, Func<DeviceCapability, int> selectBound, Func<IEnumerable<int>, int> combine, int fallback)
    {
        var bounds = (_devices ?? [])
            .SelectMany(d => d.Capabilities.Where(c => c.Kind == kind))
            .Select(selectBound)
            .ToList();
        return bounds.Count == 0 ? fallback : combine(bounds);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _devices = await FetchIndividualLightsAsync();
            await RecordRefreshTimeAsync();
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Loading devices");
        }
    }

    /// <summary>
    /// Re-fetches the device list and bumps <see cref="_refreshSignal"/> so every <see cref="DeviceCard"/>
    /// re-fetches its own state too, all bypassing the ~12s cache for an immediate, accurate read.
    /// </summary>
    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            _devices = await FetchIndividualLightsAsync(forceRefresh: true);
            _error = null;
            _refreshSignal++;
            await RecordRefreshTimeAsync();
        }
        catch (Exception ex)
        {
            _error = UserFacingError.From(ex, Logger, "Refreshing devices");
        }
        finally
        {
            _refreshing = false;
        }
    }

    /// <summary>
    /// Broadcasts a bulk command to every <see cref="DeviceCard"/> via its <c>BulkCommand</c>
    /// parameter; each card applies whichever field is populated if — and only if — it supports
    /// that capability, skipping it otherwise.
    /// </summary>
    private void OnBulkBrightnessChanged(ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var brightness) || brightness is < 0 or > 100)
        {
            _error = "Brightness must be a whole number from 0 to 100.";
            return;
        }

        _bulkBrightness = brightness;
        _error = null;
        _bulkCommand = new BulkLightCommand(++_bulkCommandId, _bulkBrightness, null, null);
    }

    private void OnBulkColorChanged(ChangeEventArgs e)
    {
        _bulkColorHex = (string)e.Value!;
        _bulkCommand = new BulkLightCommand(++_bulkCommandId, null, RgbColor.FromHex(_bulkColorHex), null);
    }

    private void OnBulkColorTemperatureChanged(ChangeEventArgs e)
    {
        _bulkColorTemperatureKelvin = int.Parse((string)e.Value!);
        _bulkCommand = new BulkLightCommand(++_bulkCommandId, null, null, _bulkColorTemperatureKelvin);
    }

    /// <summary>
    /// Formats "now" in the viewer's own browser timezone via JS interop — Blazor Server runs
    /// entirely server-side, so DateTime.Now/ToLocalTime() would use the server's timezone instead,
    /// which may not match whoever is looking at the page.
    /// </summary>
    private async Task RecordRefreshTimeAsync()
    {
        var utcNowIso = DateTime.UtcNow.ToString("o");
        _lastRefreshedLocalTime = await JSRuntime.InvokeAsync<string>("goveeController.formatLocalTime", utcNowIso);
    }

    /// <summary>
    /// Lists devices, excluding Govee's group/scenic control surfaces (e.g. "Same-Model Group
    /// Control", DreamView scenic groups) — this page only shows individual physical bulbs.
    /// Those group/scenic devices are still selectable as shortcut targets on the Shortcuts page.
    /// </summary>
    private async Task<IReadOnlyList<Device>> FetchIndividualLightsAsync(bool forceRefresh = false)
    {
        var devices = await DeviceControlService.ListDevicesAsync(forceRefresh, _cts.Token);
        return devices.Where(d => d.IsIndividualLight).ToList();
    }

    private void OnAutoRefreshChanged(ChangeEventArgs e)
    {
        _autoRefreshSeconds = int.Parse((string)e.Value!);
        RestartAutoRefreshTimer();
    }

    /// <summary>
    /// (Re)configures the background timer backing the auto-refresh dropdown. Disposing and
    /// recreating the timer (rather than reusing one via <c>Change</c>) keeps the "off" case
    /// (interval &lt;= 0) trivial — no timer exists at all while auto-refresh is disabled.
    /// </summary>
    private void RestartAutoRefreshTimer()
    {
        _autoRefreshTimer?.Dispose();
        _autoRefreshTimer = null;

        if (_autoRefreshSeconds <= 0)
        {
            return;
        }

        var interval = TimeSpan.FromSeconds(_autoRefreshSeconds);
        _autoRefreshTimer = new System.Threading.Timer(OnAutoRefreshTick, null, interval, interval);
    }

    /// <summary>
    /// Timer callback — runs on a thread-pool thread, not the component's render sync context, so
    /// updating state has to go through InvokeAsync. Unlike a normal @onclick handler, code invoked
    /// this way does NOT automatically re-render afterward — StateHasChanged() must be called
    /// explicitly, otherwise the refreshed data lands in the component's fields but the browser
    /// never repaints. This exists specifically to catch up on any command whose result never made
    /// it back to the UI (e.g. a dropped click, or Govee's cloud state lagging behind an applied command).
    /// </summary>
    private void OnAutoRefreshTick(object? state)
    {
        _ = InvokeAsync(async () =>
        {
            // Skip this tick rather than overlap if a refresh (manual or previous tick) is still
            // in flight — the interval will simply catch the next one.
            if (_refreshing)
            {
                return;
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();

        if (_autoRefreshTimer is null)
        {
            return;
        }

        // Timer.DisposeAsync (unlike the synchronous Dispose) waits for any callback that's
        // already running to finish before returning, instead of just stopping future ticks. That
        // matters here specifically: OnAutoRefreshTick calls InvokeAsync against this component,
        // and if disposal raced ahead of an in-flight tick, that InvokeAsync call would run against
        // a component already torn down, throwing ObjectDisposedException.
        await _autoRefreshTimer.DisposeAsync();
    }
}
